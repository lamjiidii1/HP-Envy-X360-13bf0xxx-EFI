 	return n;
 }
 
+// ─── 6: package/power MSR snapshot ──────────────────────────────────────────────────────────────────────────────
+// rdmsr_carefully() probes the MSR and reports a fault instead of taking a #GP in the kernel, so the snapshot is safe
+// on parts that do not implement a C-state (e.g. no C8/C9/C10 residency MSR).
+extern "C" int rdmsr_carefully(uint32_t msr, uint32_t *lo, uint32_t *hi);
+
+struct XpMsrSample { uint32_t id; int32_t status; uint64_t value; };
+static const uint32_t gXpMsrIds[] = {
+	0x0E2,  // MSR_PKG_CST_CONFIG_CONTROL: bits 3:0 package C-state limit, bit 15 CFG lock
+	0x060,  // MSR_PKG_C2_RESIDENCY
+	0x3F8,  // MSR_PKG_C3_RESIDENCY
+	0x3F9,  // MSR_PKG_C6_RESIDENCY
+	0x3FA,  // MSR_PKG_C7_RESIDENCY
+	0x630,  // MSR_PKG_C8_RESIDENCY
+	0x631,  // MSR_PKG_C9_RESIDENCY
+	0x632,  // MSR_PKG_C10_RESIDENCY
+	0xDB0,  // MSR_PKG_HDC_CTL (hardware duty cycling can hold the package out of deep C-states)
+	0xDB1,  // MSR_PM_CTL1 (per-core idle target)
+	0x1FC,  // MSR_POWER_CTL
+	0x1A0,  // IA32_MISC_ENABLE
+	0x1B0,  // IA32_ENERGY_PERF_BIAS
+	0x19C,  // IA32_THERM_STATUS
+	0x610,  // MSR_PKG_POWER_LIMIT
+	0x614,  // MSR_PKG_POWER_INFO
+	0x770,  // IA32_PM_ENABLE
+	0x771,  // IA32_HWP_CAPABILITIES
+	0x774,  // IA32_HWP_REQUEST
+	0x0CE,  // MSR_PLATFORM_INFO
+};
+static const size_t gXpMsrCount = sizeof(gXpMsrIds) / sizeof(gXpMsrIds[0]);
+static XpMsrSample gXpMsr[sizeof(gXpMsrIds) / sizeof(gXpMsrIds[0])];
+
+static int xpMsrHandler SYSCTL_HANDLER_ARGS {
+	for (size_t i = 0; i < gXpMsrCount; i++) {
+		uint32_t lo = 0, hi = 0;
+		const int err = rdmsr_carefully(gXpMsrIds[i], &lo, &hi);
+		gXpMsr[i].id = gXpMsrIds[i];
+		gXpMsr[i].status = err;
+		gXpMsr[i].value = err ? 0 : ((uint64_t)hi << 32) | lo;
+	}
+	return sysctl_handle_opaque(oidp, gXpMsr, sizeof(gXpMsr), req);
+}
+
+static int gXpPcst = -1, gXpPcstStatus = -2;   // debug.xepm.pcst: attempted package C-state limit, applied value
+
+// Writing debug.xepm.pcst sets MSR 0xE2 bits 3:0 (deepest enabled package C-state) on the current CPU. The write is
+// refused when the CFG lock bit is set, because a locked 0xE2 write faults and would panic the kernel. 8 is the deepest
+// encoding and "no limit" on TGL/ADL/RPL; 9-15 are reserved. Compared with the residency counters in debug.xepm.msr to
+// prove whether the limit is what holds the package out of C2+.
+static int xpPcstHandler SYSCTL_HANDLER_ARGS {
+	int v = gXpPcst;
+	const int rc = sysctl_handle_int(oidp, &v, 0, req);
+	if (rc || !req->newptr) return rc;
+	if (v < 0 || v > 8) { gXpPcstStatus = -1; return EINVAL; }
+	uint32_t lo = 0, hi = 0;
+	if (rdmsr_carefully(0x0E2, &lo, &hi)) { gXpPcstStatus = -2; return EIO; }
+	const uint64_t old = ((uint64_t)hi << 32) | lo;
+	if (old & (1ULL << 15)) { gXpPcstStatus = -3; return EPERM; }   // CFG lock
+	if ((old & 0xF) != (uint64_t)v) xpWrmsr(0x0E2, (old & ~0xFULL) | (uint64_t)v);
+	uint32_t nlo = 0, nhi = 0;
+	gXpPcst = rdmsr_carefully(0x0E2, &nlo, &nhi) ? v : (int)(nlo & 0xF);
+	gXpPcstStatus = gXpPcst;
+	IOLog("WEX PM: package C-state limit %u -> %d (0xE2 was 0x%llx)\n", (unsigned)v, gXpPcst, old);
+	return 0;
+}
+
 static void xpApply(thread_call_param_t, thread_call_param_t) {
 	gXpCst = xpCstFix();
 	gXpD3 += xpD3();
@@ -151,6 +220,11 @@ SYSCTL_INT(_debug_xepm, OID_AUTO, eet_off, CTLFLAG_RD, &gXpEet, 0, "");
 SYSCTL_INT(_debug_xepm, OID_AUTO, cst, CTLFLAG_RD, &gXpCst, 0, "1 = C8/C10 on");
