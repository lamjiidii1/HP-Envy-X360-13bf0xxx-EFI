+            "package/power MSR snapshot: {u32 id, i32 status, u64 value}[]");
+SYSCTL_PROC(_debug_xepm, OID_AUTO, pcst, CTLTYPE_INT | CTLFLAG_RW, 0, 0, xpPcstHandler, "I",
+            "package C-state limit written to 0xE2 bits 3:0, -1 = untouched");
+SYSCTL_INT(_debug_xepm, OID_AUTO, pcst_status, CTLFLAG_RD, &gXpPcstStatus, 0, "0xE2 limit now applied / negative = refused");
 
